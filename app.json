{
  "expo": {
    "name": "Procrastin8r",
    "slug": "procrastin8r",
    "owner": "syxxn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "procrastin8r",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.procrastin8r",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#18181b"
      },
      "package": "app.procrastin8r",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 132,
          "resizeMode": "contain",
          "backgroundColor": "#18181b"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
